# Copy this file to docker-compose.override.yml and edit to suit your setup.
# Docker Compose automatically merges it with docker-compose.yml.

services:
  lemon-chat:
    # Override the port — set server.port in lemon.toml to match
    ports:
      - "8169:8169"

    # Bind-mount ./data so lemon.toml and lemon.db are easy to edit on the host
    volumes:
      - ./data:/data
      # Or keep the config in the repo (e.g. deploy/lemon.toml) so `git pull`
      # updates it. Mount the directory rather than the file: git replaces the
      # file on pull, which a single-file bind mount would not pick up.
      # - ./deploy:/config:ro

    # With the config in the repo, point lemon-chat at it and supply the
    # secrets its ${VAR} references need from a gitignored .env file.
    # entrypoint: ["lemon-chat", "--config", "/config/lemon.toml"]
    # env_file: .env

    # Allow the container to reach an Ollama instance running on the host.
    # host.docker.internal is built-in on Docker Desktop; on Linux it needs this.
    extra_hosts:
      - "host.docker.internal:host-gateway"
