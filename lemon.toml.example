[server]
port     = 8080
data_dir = "."    # directory for lemon.db, avatars, attachments (relative or absolute)

# The model used for background tasks (e.g. auto-title generation).
# Must match the name of one of the [[model]] entries below.
default_model = "meta-llama/Llama-3.2-8B-Instruct"

# Timeout for establishing a TCP connection to any model server (seconds).
dial_timeout_seconds = 10

# Maximum total time allowed for a single model response, streaming or otherwise (seconds).
response_timeout_seconds = 600

# Maximum number of tool-call rounds per message before the loop is cut off.
max_tool_loops = 5

# Enable verbose debug logging (title worker, trigger conditions, HTTP responses).
# debug = true

# Log every raw SSE token from the model to <data_dir>/model_tokens.log.
# Useful for diagnosing streaming issues. Also available as --token-log flag.
# token_log = true

# Bootstrap: runs once on first start when the DB has no users.
# Ignored once any user exists in the database.
# Override with env vars: LEMON_ADMIN_USERNAME, LEMON_ADMIN_PASSWORD
[bootstrap]
admin_username = "admin"
admin_password = ""        # empty = no password required to log in

# One [[model_server]] section per OpenAI-compatible inference server.
# The name is referenced by each [[model]] entry via model_server.
[[model_server]]
name     = "local"
api_base = "http://localhost:8000/v1"
# api_key  = ""     # optional — sent as Bearer token if set

# Add more servers as needed:
# [[model_server]]
# name     = "remote"
# api_base = "http://remote-host:8000/v1"
# api_key  = "sk-..."

[[model]]
name         = "meta-llama/Llama-3.2-8B-Instruct"
display_name = "Llama 3.2 8B"
model_server = "local"
# modes = ["chat", "complete"]   # omit to allow in both; restrict with ["chat"] or ["complete"]

[[model]]
name         = "mistralai/Mistral-7B-Instruct-v0.3"
display_name = "Mistral 7B"
model_server = "local"

# Optional: SearXNG web search integration.
# When set, the searxng tool becomes available to characters and the
# research feature can be used.
# [searxng]
# url = "http://localhost:8181"

# Optional: research feature tuning. Research also requires [searxng] above.
# All keys are optional; the values shown are the defaults.
# [research]
# model = ""                  # model for research jobs (falls back to default_model)
# max_rounds = 8              # hard upper bound on research rounds
# max_time_seconds = 600      # wall-clock budget, checked at the start of each round
# max_urls_per_round = 3      # URLs fetched per query per round
# max_content_chars = 15000   # page content truncation limit before extraction
# max_report_tokens = 8192    # max_tokens for synthesis and final report calls
# extraction_concurrency = 3  # concurrent URL fetch+extract tasks
# min_rounds = 2              # stop-check is skipped until this many rounds complete
# max_empty_rounds = 2        # consecutive zero-finding rounds before aborting
# synthesis_window = 10       # only the last N findings are passed to each synthesis call

# Optional: ComfyUI image generation integration.
# Set url plus whichever workflow files you have. Each enables a separate tool:
#   sdxl_file → generate_image_sdxl  (20–50 steps, supports negative prompt)
#   flux_file → generate_image_flux  (1–4 steps, faster, no negative prompt)
# Workflow JSON files use placeholder strings: "__PROMPT__", "__NEGATIVE_PROMPT__",
#   __SEED__, __CFG__, __WIDTH__, __HEIGHT__, __STEPS__
# [comfyui]
# url       = "http://localhost:8188"
# sdxl_file = "data/comfyui/sdxl.json"
# flux_file = "data/comfyui/flux.json"
