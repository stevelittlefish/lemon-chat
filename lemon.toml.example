[server]
port       = 8080
data_dir   = "."       # directory for lemon.db, avatars, attachments (relative or absolute)
static_dir = "static"  # frontend assets; resolved to an absolute path at startup

# The model used for background tasks (e.g. auto-title generation).
# Must match the name of one of the [[model]] entries below.
default_model = "meta-llama/Llama-3.2-8B-Instruct"

# Timeout for establishing a TCP connection to any model server (seconds).
dial_timeout_seconds = 10

# Maximum total time allowed for a single model response, streaming or otherwise (seconds).
response_timeout_seconds = 600

# Maximum number of tool-call rounds per message before the loop is cut off.
max_tool_loops = 5

# Enable verbose debug logging (title worker, trigger conditions, HTTP responses).
# debug = true

# Log model request/response transcripts to <data_dir>/model_tokens.log for
# diagnostics and replay. OAuth and account headers are redacted; prompt and
# response content is recorded. Also available as the --token-log flag.
# token_log = true

# Bootstrap: runs once on first start when the DB has no users.
# Ignored once any user exists in the database.
# Override with env vars: LEMON_ADMIN_USERNAME, LEMON_ADMIN_PASSWORD
[bootstrap]
admin_username = "admin"
admin_password = ""        # empty = no password required to log in

# One [[model_server]] section per OpenAI-compatible inference server.
# The name is referenced by each [[model]] entry via model_server.
[[model_server]]
name     = "local"
api_base = "http://localhost:8000/v1"
# api_key  = ""     # optional — sent as Bearer token if set

# Add more servers as needed:
# [[model_server]]
# name     = "remote"
# api_base = "http://remote-host:8000/v1"
# api_key  = "sk-..."

# Servers whose api_base is on openrouter.ai are detected automatically: a
# background worker fetches per-token pricing for their models once a day and
# the UI shows it in the model pickers. No extra config is required.
# [[model_server]]
# name     = "openrouter"
# api_base = "https://openrouter.ai/api/v1"
# api_key  = "sk-or-..."

# OpenAI via a ChatGPT/OpenAI account login instead of an api_key. Set
# api = "responses" to use OpenAI's Responses API, and auth = "oauth" to send
# the shared login token (obtained via the OpenAI account login) rather than a
# static api_key. A single token is shared by every user on the network.
#   api:  "chat_completions" (default) | "responses"
#   auth: "api_key" (default) | "oauth"
# [[model_server]]
# name     = "openai"
# api_base = "https://chatgpt.com/backend-api/codex"
# api      = "responses"
# auth     = "oauth"

[[model]]
name         = "meta-llama/Llama-3.2-8B-Instruct"
display_name = "Llama 3.2 8B"
model_server = "local"
# modes = ["chat", "complete"]   # omit to allow in both; restrict with ["chat"] or ["complete"]; use [] to hide from both pickers (still usable for research)

[[model]]
name         = "mistralai/Mistral-7B-Instruct-v0.3"
display_name = "Mistral 7B"
model_server = "local"

# Optional: SearXNG web search integration.
# When set, the searxng tool becomes available to characters and the
# research feature can be used.
# [searxng]
# url = "http://localhost:8181"

# Optional: research feature tuning. Research also requires [searxng] above.
# All keys are optional; the values shown are the defaults.
# [research]
# model = ""                  # model for research jobs (falls back to default_model)
# html_report_model = ""      # model for the HTML report step (falls back to the job's model); the start form can override per job
# worker_model = ""           # model for the worker tier — page reading plus the mechanical slug/classify/query-gen/decide calls (falls back to the job's model); a cheap/local model here cuts most of the cost. The start form can override per job
# max_rounds = 8              # hard upper bound on research rounds (effort 3; the per-job effort/time controls in the UI layer on top of these)
# max_time_seconds = 600      # default wall-clock budget; the UI time-limit field overrides it per job
# max_urls_per_round = 3      # URLs fetched per query per round
# max_content_chars = 15000   # page content truncation limit before extraction
# synthesis_tokens = 8192     # max_tokens for the per-round synthesis (working summary)
# final_report_tokens = 32768 # max_tokens for the final report (and deep-report section) writes — separate from synthesis so the report is not capped at the smaller synthesis budget
# max_report_tokens = 8192    # deprecated alias — seeds synthesis_tokens when that key is unset
# html_report_tokens = 16384  # max_tokens per call for the designed HTML report step; if a call is truncated it is auto-continued (up to 4 times) so large documents still finish
# extraction_concurrency = 3  # concurrent URL fetch+extract tasks
# min_rounds = 2              # stop-check is skipped until this many rounds complete
# max_empty_rounds = 2        # consecutive zero-finding rounds before aborting
# synthesis_window = 10       # only the last N findings are passed to each synthesis call

# Optional: ComfyUI image generation integration.
# Set url plus whichever workflow files you have. Each enables a separate tool:
#   sdxl_workflow → generate_image_sdxl  (20–50 steps, supports negative prompt)
#   flux_workflow → generate_image_flux  (1–4 steps, faster, no negative prompt)
# Workflow JSON files use placeholder strings: "__PROMPT__", "__NEGATIVE_PROMPT__",
#   __SEED__, __CFG__, __WIDTH__, __HEIGHT__, __STEPS__
# [comfyui]
# url           = "http://localhost:8188"
# sdxl_workflow = "data/comfyui/sdxl.json"
# flux_workflow = "data/comfyui/flux.json"
